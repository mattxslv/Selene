<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    xmlns:pin="clr-namespace:Playnite.Input;assembly=Playnite"
                    mc:Ignorable="d">

    <!-- Selene main screen. Layers, bottom to top:
           SeleneLibrary      Playnite's own game grid + filters (opened from the Library card, B goes home)
           WelcomeHubOverlay  the home: art, game row, logo, Play/Details/Favourite, info, screenshots
           top bar            filter tabs (home) / filter presets (library), clock, notifications, menu
           AcceuilSettings    the login (Selene Core builds its scene into LoginCenterShell and removes the layer)
         Element names are what Selene Core looks for - keep them when restyling. -->
    <Style TargetType="{x:Type Main}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Main}">
                    <Grid x:Name="PART_MainHost"
                          d:DesignWidth="{StaticResource DesignWidth}"
                          d:DesignHeight="{StaticResource DesignHeight}"
                          d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Grid x:Name="PART_ViewHost" Background="{DynamicResource SeleneScrimBrush}">

                            <!-- ================= LIBRARY ================= -->
                            <!-- Selene's own: the selected game's art fills the screen behind its big logo; rest on a game and its
                                 trailer takes over the background (Selene Core plays it in SeleneLibraryTrailerHost), a black fade on
                                 the left keeps the logo readable. Button hints over a row of big, close covers. PART_* are Playnite's. -->
                            <Grid x:Name="SeleneLibrary" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="100" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="104" />
                                    <RowDefinition Height="0" />
                                </Grid.RowDefinitions>
                                <Border x:Name="SeleneLibraryBase" Grid.RowSpan="5" Background="{DynamicResource SeleneBaseBrush}" Panel.ZIndex="-3"/>
                                <Image Panel.ZIndex="-3" x:Name="SeleneLibraryWallpaper" Grid.RowSpan="5" Source="{DynamicResource SeleneWallpaper}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant" Opacity="0.6"/>
                                <!-- (AnimationEnabled: the art crossfades from game to game instead of cutting; the small wait lets a held stick settle) -->
                                <FadeImage x:Name="PART_ImageBackground" Grid.RowSpan="5" Panel.ZIndex="-3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SourceUpdateDelay="150" AnimationEnabled="True" Stretch="{DynamicResource SeleneBackgroundStretch}"/>
                                <!-- the trailer, full screen over the art (faded in by Selene Core) -->
                                <!-- the trailer, like the legacy theme: a 16:9 box 800 high on the right, top edge, masked by its picture
                                     (fades in from the left over the first half, fades out toward the bottom) -->
                                <Grid x:Name="SeleneLibraryTrailerHost" Grid.RowSpan="5" Width="1422" Height="800" HorizontalAlignment="Right" VerticalAlignment="Top"
                                      Background="Black" Opacity="0" IsHitTestVisible="False" ClipToBounds="True" Panel.ZIndex="-1">
                                    <Grid.OpacityMask>
                                        <ImageBrush ImageSource="{ThemeFile 'Images/TrailerMask.png'}" Stretch="Fill"/>
                                    </Grid.OpacityMask>
                                </Grid>
                                <!-- over the art, the legacy theme's two shades: from the bottom, and from the left out to the middle -->
                                <Border x:Name="SeleneLibraryShadeBottom" Grid.RowSpan="5" IsHitTestVisible="False" Panel.ZIndex="-2">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                            <GradientStop Color="#F0000000" Offset="0"/>
                                            <GradientStop Color="#90000000" Offset="0.12"/>
                                            <GradientStop Color="#500F0C10" Offset="0.26"/>
                                            <GradientStop Color="#00000000" Offset="0.48"/>
                                            <GradientStop Color="#00000000" Offset="0.82"/>
                                            <GradientStop Color="#20000000" Offset="0.94"/>
                                            <GradientStop Color="#500F0C10" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border x:Name="SeleneLibraryShadeArt" Grid.RowSpan="5" IsHitTestVisible="False" Panel.ZIndex="-2">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#F0000000" Offset="0"/>
                                            <GradientStop Color="#00000000" Offset="0.5"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- logo, chips and genres come in together each time the game changes (the logo's binding signals it) -->
                                <StackPanel Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="100,0,0,0" Width="840">
                                    <StackPanel.RenderTransform><TranslateTransform x:Name="LibraryInfoShift" X="0"/></StackPanel.RenderTransform>
                                    <StackPanel.Triggers>
                                        <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                                        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                                        <LinearDoubleKeyFrame KeyTime="0:0:0.12" Value="0"/>
                                                        <LinearDoubleKeyFrame KeyTime="0:0:0.42" Value="1"/>
                                                    </DoubleAnimationUsingKeyFrames>
                                                    <DoubleAnimation Storyboard.TargetName="LibraryInfoShift" Storyboard.TargetProperty="X" From="-24" To="0" BeginTime="0:0:0.12" Duration="0:0:0.3">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </StackPanel.Triggers>
                                <Grid Height="250">
                                    <TextBlock x:Name="SeleneLibraryLogoPath" Tag="{Api Paths.ConfigurationPath}" Visibility="Collapsed">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}\ExtraMetadata\games\{1}\logo.png">
                                                <Binding RelativeSource="{RelativeSource Self}" Path="Tag"/>
                                                <Binding Path="SelectedGame.Id"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <Image x:Name="SeleneLibraryLogo" Source="{Binding ElementName=SeleneLibraryLogoPath, Path=Text, Converter={StaticResource ImageStringToImageConverter}, NotifyOnTargetUpdated=True, IsAsync=True}"
                                           MaxWidth="600" MaxHeight="240" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Bottom" RenderOptions.BitmapScalingMode="Fant">
                                    </Image>
                                    <TextBlock Text="{Binding SelectedGame.DisplayName}" Foreground="{DynamicResource SeleneInkBrush}" FontSize="56" FontFamily="{DynamicResource FontMain}"
                                               HorizontalAlignment="Center" VerticalAlignment="Bottom" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="220">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=SeleneLibraryLogo, Path=Source}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <!-- the game at a glance: playtime, last played, where it's from (the store's own logo), its year -->
                                <StackPanel x:Name="SeleneLibraryStats" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <!-- no games in Collection: nothing to tell about, nothing to do with one -->
                                                <DataTrigger Binding="{Binding Items.Count, ElementName=PART_ListGameItems}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <StackPanel Margin="0,0,26,0">
                                        <TextBlock Text="PLAYTIME" Foreground="{DynamicResource SeleneInk60Brush}" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                        <TextBlock Text="{Binding SelectedGame.Playtime, Mode=OneWay, Converter={StaticResource PlayTimeToStringConverter}}" Foreground="{DynamicResource SeleneInkBrush}" FontSize="21" FontFamily="{DynamicResource FontMain}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Rectangle Width="1" Fill="{DynamicResource SeleneInk25Brush}" Margin="0,4,26,4"/>
                                    <StackPanel Margin="0,0,26,0">
                                        <TextBlock Text="LAST PLAYED" Foreground="{DynamicResource SeleneInk60Brush}" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                        <TextBlock Text="{DynamicResource SeleneLastPlayed}" Foreground="{DynamicResource SeleneInkBrush}" FontSize="21" FontFamily="{DynamicResource FontMain}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Rectangle Width="1" Fill="{DynamicResource SeleneInk25Brush}" Margin="0,4,26,4"/>
                                    <StackPanel Margin="0,0,26,0">
                                        <TextBlock Text="PLATFORM" Foreground="{DynamicResource SeleneInk60Brush}" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Grid Width="22" Height="22" Margin="0,0,9,0" VerticalAlignment="Center">
                                                <Path Data="{DynamicResource SelenePlatformIcon}" Fill="{DynamicResource SeleneInkBrush}" Stretch="Uniform"/>
                                                <TextBlock Text="{DynamicResource SelenePlatformFallbackGlyph}" FontFamily="{DynamicResource SeleneIconFont}" FontSize="21" Foreground="{DynamicResource SeleneInkBrush}" VerticalAlignment="Center" Visibility="{DynamicResource SelenePlatformFallback}"/>
                                            </Grid>
                                            <TextBlock Text="{DynamicResource SelenePlatformName}" Foreground="{DynamicResource SeleneInkBrush}" FontSize="21" FontFamily="{DynamicResource FontMain}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Rectangle Width="1" Fill="{DynamicResource SeleneInk25Brush}" Margin="0,4,26,4"/>
                                    <StackPanel>
                                        <TextBlock Text="RELEASED" Foreground="{DynamicResource SeleneInk60Brush}" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                        <TextBlock Text="{Binding SelectedGame.ReleaseYear, Mode=OneWay, TargetNullValue=-, FallbackValue=-}" Foreground="{DynamicResource SeleneInkBrush}" FontSize="21" FontFamily="{DynamicResource FontMain}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <!-- how long it takes to beat (the HowLongToBeat add-on, when it has a time for this game; Selene's "HowLongToBeat times" switch) -->
                                    <StackPanel x:Name="SeleneHltbStatLibrary" Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=HowLongToBeat, Path=HasData}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                    <DataTrigger Binding="{PluginSettings Plugin=HowLongToBeat, Path=MainStory}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Rectangle Width="1" Fill="{DynamicResource SeleneInk25Brush}" Margin="26,4,26,4"/>
                                        <StackPanel>
                                            <TextBlock Text="TIME TO BEAT" Foreground="{DynamicResource SeleneInk60Brush}" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                            <TextBlock Text="{PluginSettings Plugin=HowLongToBeat, Path=MainStoryFormat}" Foreground="{DynamicResource SeleneInkBrush}" FontSize="21" FontFamily="{DynamicResource FontMain}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <!-- genres, quieter, under the stats -->
                                <ItemsControl x:Name="SeleneLibraryGenres" ItemsSource="{Binding SelectedGame.Genres}" HorizontalAlignment="Center" Margin="0,16,0,0" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource SeleneInk60Brush}" FontSize="16" FontFamily="Segoe UI" Margin="10,0,10,0"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </StackPanel>

                                <!-- achievements of the selected game (Playnite Achievements), bottom right above the covers (clear of the chosen one, which grows): a trophy badge
                                     (gold once every one is earned), the count large with the share beside it, a glowing bar -->
                                <!-- (no panel or shadow of its own: an effect on the whole block drew its words soft) -->
                                <Border Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,64,28" Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{PluginSettings Plugin=PlayniteAchievements, Path=HasData, FallbackValue=False}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                                        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                                        <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="0"/>
                                                        <LinearDoubleKeyFrame KeyTime="0:0:0.45" Value="1"/>
                                                    </DoubleAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- signals each new game for the fade (Playnite's add-on bindings can't) -->
                                        <TextBlock Text="{Binding SelectedGame.Id, NotifyOnTargetUpdated=True}" Visibility="Collapsed"/>
                                        <Grid Width="52" Height="52" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <Ellipse>
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource SeleneInk15Brush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=PlayniteAchievements, Path=IsCompleted}" Value="True"><Setter Property="Fill" Value="#33E8C46A"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="&#xEA23;" FontFamily="{DynamicResource SeleneIconFont}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{PluginSettings Plugin=PlayniteAchievements, Path=IsCompleted}" Value="True"><Setter Property="Foreground" Value="#FFE8C46A"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center" Width="250">
                                            <TextBlock Text="ACHIEVEMENTS" Foreground="{DynamicResource SeleneInk60Brush}" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                            <Grid Margin="0,2,0,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                    <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=Unlocked, FallbackValue='-'}" Foreground="{DynamicResource SeleneInkBrush}" FontSize="26" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                                                    <TextBlock Text=" / " Foreground="{DynamicResource SeleneInk60Brush}" FontSize="20" FontFamily="Segoe UI" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                                    <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=Total, FallbackValue='-'}" Foreground="{DynamicResource SeleneInk60Brush}" FontSize="20" FontFamily="Segoe UI" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                                </StackPanel>
                                                <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=Percent, FallbackValue=0, StringFormat='{}{0:0}%'}" Foreground="{DynamicResource SeleneInk90Brush}" FontSize="17" FontWeight="SemiBold" FontFamily="Segoe UI" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                            </Grid>
                                            <ProgressBar Value="{PluginSettings Plugin=PlayniteAchievements, Path=Percent, FallbackValue=0}" Maximum="100" Height="6" Margin="0,8,0,0" Focusable="False">
                                                <ProgressBar.Template>
                                                    <ControlTemplate TargetType="ProgressBar">
                                                        <Grid>
                                                            <Border x:Name="PART_Track" CornerRadius="3" Background="{DynamicResource SeleneInk25Brush}"/>
                                                            <Border x:Name="PART_Indicator" CornerRadius="3" Background="{DynamicResource GlyphBrush}" HorizontalAlignment="Left">
                                                                <Border.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="10" Opacity="0.7" Color="{DynamicResource GlyphColor}"/></Border.Effect>
                                                            </Border>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </ProgressBar.Template>
                                            </ProgressBar>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- button hints along the bottom, split like the home -->
                                <Border x:Name="SeleneLibraryHints" Grid.Row="3" Margin="64,0,64,0" VerticalAlignment="Center">
                                    <Border.Resources>
                                        <Style x:Key="HintBadge" TargetType="Border">
                                            <Setter Property="MinWidth" Value="30"/>
                                            <Setter Property="Padding" Value="8,0"/>
                                            <Setter Property="Height" Value="30"/>
                                            <Setter Property="CornerRadius" Value="15"/>
                                            <Setter Property="Background" Value="{DynamicResource SeleneInkBrush}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="0,0,10,0"/>
                                        </Style>
                                        <Style x:Key="HintKey" TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="13"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="FontFamily" Value="Segoe UI"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SeleneScrimBrush}"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="0,0,0,1"/>
                                        </Style>
                                        <Style x:Key="HintLabel" TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="19"/>
                                            <Setter Property="FontFamily" Value="Segoe UI"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SeleneInkBrush}"/>
                                        </Style>
                                        <Style x:Key="HintHold" TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="13"/>
                                            <Setter Property="FontFamily" Value="Segoe UI"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SeleneInk60Brush}"/>
                                        </Style>
                                        <Style x:Key="HintItem" TargetType="StackPanel">
                                            <Setter Property="Orientation" Value="Horizontal"/>
                                            <Setter Property="Margin" Value="22,0,22,0"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </Border.Resources>
                                    <Grid>
                                    <!-- left: always there (like the home); right: what the selected game offers -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <StackPanel Style="{StaticResource HintItem}" Margin="0,0,22,0">
                                            <Border Style="{StaticResource HintBadge}"><TextBlock Text="&#xE3E0;" FontFamily="{DynamicResource SeleneIconFont}" Style="{StaticResource HintKey}" FontSize="17" FontWeight="Normal" Margin="0"/></Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Spotlight" Style="{StaticResource HintLabel}"/>
                                                <TextBlock Text="Hold: Search" Style="{StaticResource HintHold}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource HintItem}">
                                            <Border Style="{StaticResource HintBadge}"><TextBlock Text="&#xE5D2;" FontFamily="{DynamicResource SeleneIconFont}" Style="{StaticResource HintKey}" FontSize="19" FontWeight="Normal" Margin="0"/></Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Menu" Style="{StaticResource HintLabel}"/>
                                                <TextBlock Text="Hold: Settings" Style="{StaticResource HintHold}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- no games in Collection: just B, back to Spotlight (the game hints beside it are hidden) -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Items.Count, ElementName=PART_ListGameItems}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <StackPanel Style="{StaticResource HintItem}">
                                            <Border Style="{StaticResource HintBadge}"><TextBlock Text="{DynamicResource SelenePromptB}" Style="{StaticResource HintKey}"/></Border>
                                            <TextBlock Text="Back" Style="{StaticResource HintLabel}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <!-- no games in Collection: nothing to tell about, nothing to do with one -->
                                                    <DataTrigger Binding="{Binding Items.Count, ElementName=PART_ListGameItems}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <StackPanel Style="{StaticResource HintItem}">
                                            <Border Style="{StaticResource HintBadge}"><TextBlock Text="{DynamicResource SelenePromptA}" Style="{StaticResource HintKey}"/></Border>
                                            <TextBlock Text="Play" Style="{StaticResource HintLabel}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource HintItem}">
                                            <Border Style="{StaticResource HintBadge}"><TextBlock Text="{DynamicResource SelenePromptX}" Style="{StaticResource HintKey}"/></Border>
                                            <TextBlock Text="Details" Style="{StaticResource HintLabel}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource HintItem}">
                                            <Border Style="{StaticResource HintBadge}"><TextBlock Text="{DynamicResource SelenePromptY}" Style="{StaticResource HintKey}"/></Border>
                                            <TextBlock Text="Game options" Style="{StaticResource HintLabel}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource HintItem}">
                                            <Border Style="{StaticResource HintBadge}"><TextBlock Text="{DynamicResource SelenePromptRS}" Style="{StaticResource HintKey}" FontSize="11"/></Border>
                                            <!-- Selene Core shows "Trailer sound" here while a trailer plays -->
                                            <TextBlock x:Name="SeleneLibraryRsHint" Text="Filter" Style="{StaticResource HintLabel}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- the whole library: one row of big covers, close together -->
                                <ListBoxEx x:Name="PART_ListGameItems" Grid.Row="2" Height="400" Margin="0,0,0,0" Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}"
                                           ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.ScrollUnit="Item"
                                           KeyboardNavigation.DirectionalNavigation="Once" />
                                <!-- nothing to show: Playnite's message in the middle of the screen (Selene Core sets its readable glow) -->
                                <StackPanel x:Name="SeleneLibraryEmpty" Grid.Row="0" Grid.RowSpan="4" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Items.Count, ElementName=PART_ListGameItems}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock FontSize="34" Text="{DynamicResource LOCNoGamesFound}" TextAlignment="Center" Margin="48,26,48,28" Style="{StaticResource TextBlockBaseStyle}" Foreground="{DynamicResource SeleneInkBrush}" FontFamily="{StaticResource FontMain}"/>
                                </StackPanel>

                                <!-- Playnite's filter panels open over the left side -->
                                <StackPanel Grid.Row="1" Grid.RowSpan="3" Orientation="Horizontal" HorizontalAlignment="Left" Panel.ZIndex="10">
                                    <Filters x:Name="PART_ElemFilters" Focusable="False" />
                                    <FiltersAdditional x:Name="PART_ElemFiltersAdditional" Focusable="False" />
                                    <ContentControl x:Name="PART_ContentFilterItems" Focusable="False" />
                                </StackPanel>

                                <!-- Playnite's own parts: its button hints stay hidden (Selene's are above), search / filter state, progress -->
                                <Grid Grid.Row="1" Margin="70,0,70,0" VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                        <ButtonEx x:Name="PART_ButtonInstall" Style="{DynamicResource ButtonBottomMenu}" Content="{DynamicResource LOCInstallGame}" />
                                        <ButtonEx x:Name="PART_ButtonPlay" Style="{DynamicResource ButtonBottomMenu}" Content="{DynamicResource LOCPlayGame}" />
                                        <ButtonEx x:Name="PART_ButtonDetails" Style="{DynamicResource ButtonBottomMenu}" Content="{DynamicResource LOCGameDetails}" />
                                        <ButtonEx x:Name="PART_ButtonGameOptions" Style="{DynamicResource ButtonBottomMenu}" Content="{DynamicResource LOCGameOptions}" />
                                        <ButtonEx x:Name="PART_ButtonSearch" Style="{DynamicResource ButtonBottomMenu}" Content="{DynamicResource LOCSearchLabel}" />
                                        <ButtonEx x:Name="PART_ButtonFilter" Style="{DynamicResource ButtonBottomMenu}" Content="{DynamicResource LOCFilter}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" x:Name="PART_ElemSearchActive" VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                                        <TextBlock FontSize="15" Style="{DynamicResource TextBlockBaseStyle}" Text="{DynamicResource LOCGameListSearchResults}" Margin="0,0,8,0"/>
                                        <TextBlock FontSize="15" Foreground="{DynamicResource TextBrush}" Style="{DynamicResource TextBlockBaseStyle}" Text="{Binding AppSettings.Fullscreen.FilterSettings.Name}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" x:Name="PART_ElemExtraFilterActive" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"
                                               TextAlignment="Center" Style="{DynamicResource TextBlockBaseStyle}" Text="{DynamicResource LOCGameListExtraFiltered}"/>
                                    <StackPanel x:Name="PART_ElemProgressIndicator" Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock x:Name="PART_TextProgressTooltip" Margin="0,0,12,0" FontSize="15" VerticalAlignment="Center" Style="{DynamicResource TextBlockBaseStyle}"/>
                                        <ContentControl x:Name="SeleneBusySpinner" Style="{DynamicResource ProgressIndicator}" Focusable="False" Height="26" Width="26" VerticalAlignment="Center" />
                                        <!-- with the Selene logo on: its mark, glowing, instead of the spinner (Selene Core) -->
                                        <Grid x:Name="SeleneBusyMark" Width="30" Height="30" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- ================= HOME ================= -->
                            <Grid x:Name="WelcomeHubOverlay">
                                <!-- selected game's art: Selene's hero art (media folder) over Playnite's background -->
                                <Grid x:Name="SeleneHubGameBackground" IsHitTestVisible="False">
                                    <!-- fallback for when no game is selected (empty library): the theme's gradient and the profile's wallpaper -->
                                    <Border Background="{DynamicResource SeleneBaseBrush}"/>
                                    <Image Source="{DynamicResource SeleneDefaultBackdrop}" Stretch="UniformToFill"/>
                                    <Image Source="{DynamicResource SeleneWallpaper}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant"/>
                                    <!-- the game's art; the wallpaper shows where there is none (or always, for a profile that wants that) -->
                                    <Grid x:Name="SeleneHubArt" Opacity="{DynamicResource SeleneArtOpacity}">
                                    <FadeImage Source="{Binding SelectedGame.DisplayBackgroundImage}" SourceUpdateDelay="250" AnimationEnabled="True" RenderOptions.BitmapScalingMode="Fant" Stretch="{DynamicResource SeleneBackgroundStretch}"/>
                                    <TextBlock x:Name="SeleneHeroPath" Tag="{DynamicResource SeleneHeroRoot}" Visibility="Collapsed">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text">
                                                    <Setter.Value>
                                                        <MultiBinding StringFormat="{}{0}\Hero\{1}.jpg">
                                                            <Binding RelativeSource="{RelativeSource Self}" Path="Tag"/>
                                                            <Binding Path="SelectedGame.Id"/>
                                                        </MultiBinding>
                                                    </Setter.Value>
                                                </Setter>
                                                <!-- no such art at all (a new install), or no Selene Core: nothing to look up (each missing file was a warning in Playnite's log) -->
                                                <Style.Triggers>
                                                    <Trigger Property="Tag" Value=""><Setter Property="Text" Value=""/></Trigger>
                                                    <Trigger Property="Tag" Value="{x:Null}"><Setter Property="Text" Value=""/></Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- no game selected (a card): no hero picture at all; a path to a missing file kept the last game's art up -->
                                    <FadeImage SourceUpdateDelay="250" AnimationEnabled="True" RenderOptions.BitmapScalingMode="Fant" Stretch="{DynamicResource SeleneBackgroundStretch}">
                                        <FadeImage.Style>
                                            <Style TargetType="FadeImage">
                                                <Setter Property="Source" Value="{Binding Text, ElementName=SeleneHeroPath}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedGame}" Value="{x:Null}">
                                                        <Setter Property="Source" Value="{x:Null}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </FadeImage.Style>
                                    </FadeImage>
                                    </Grid>
                                    <Border x:Name="SeleneHubShadeLeft" Background="{DynamicResource SeleneScrimBrush}" Opacity="0.3">
                                        <Border.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#E0000000" Offset="0"/>
                                                <GradientStop Color="#80000000" Offset="0.5"/>
                                                <GradientStop Color="#26000000" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.OpacityMask>
                                    </Border>
                                    <Border x:Name="SeleneHubShadeBottom" Background="{DynamicResource SeleneScrimBrush}" Opacity="0.3">
                                        <Border.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0.4"/>
                                                <GradientStop Color="#E6000000" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.OpacityMask>
                                    </Border>
                                    <!-- behind the top bar, only over bright pictures (Selene Core deepens these three shades as the picture needs) -->
                                    <Border x:Name="SeleneHubShadeTop" Background="{DynamicResource SeleneScrimBrush}" Opacity="0.3">
                                        <Border.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#E6000000" Offset="0"/>
                                                <GradientStop Color="#70000000" Offset="0.1"/>
                                                <GradientStop Color="#00000000" Offset="0.26"/>
                                            </LinearGradientBrush>
                                        </Border.OpacityMask>
                                    </Border>
                                </Grid>

                                <!-- actions Selene Core wires up (home <-> library) -->
                                <ButtonEx x:Name="SeleneNav_library" Visibility="Collapsed" Focusable="False" IsTabStop="False"/>
                                <ButtonEx x:Name="SeleneNav_hub" Visibility="Collapsed" Focusable="False" IsTabStop="False"/>
                                <ButtonEx x:Name="SeleneNav_store" Visibility="Collapsed" Focusable="False" IsTabStop="False"/>
                                <ButtonEx x:Name="SeleneNav_activity" Visibility="Collapsed" Focusable="False" IsTabStop="False"/>
                                <ButtonEx x:Name="SeleneNav_captures" Visibility="Collapsed" Focusable="False" IsTabStop="False"/>
                                <ButtonEx x:Name="SeleneNav_surprise" Visibility="Collapsed" Focusable="False" IsTabStop="False"/>
                                <ButtonEx x:Name="SeleneNav_news" Visibility="Collapsed" Focusable="False" IsTabStop="False"/>
                                <ButtonEx x:Name="SeleneNav_achievements" Visibility="Collapsed" Focusable="False" IsTabStop="False"/>

                                <Grid Margin="0,120,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid x:Name="HubTopProfileSummary" Grid.Row="0" Margin="80,0,80,0" RenderTransformOrigin="0.5,0.5"
                                          KeyboardNavigation.DirectionalNavigation="Continue">
                                        <Grid.RenderTransform>
                                            <TranslateTransform x:Name="HubTopProfileSummaryShift" Y="0"/>
                                        </Grid.RenderTransform>
                                        <Grid.Resources>
                                            <CollectionViewSource x:Key="SeleneGames" Source="{Binding GamesView.CollectionView.SourceCollection}">
                                                <CollectionViewSource.SortDescriptions>
                                                    <scm:SortDescription PropertyName="LastActivity" Direction="Descending"/>
                                                </CollectionViewSource.SortDescriptions>
                                            </CollectionViewSource>

                                            <Style x:Key="SeleneTileStyle" TargetType="ListBoxItem">
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                <Setter Property="pbeh:FocusBahaviors.FocusBinding" Value="{Binding IsSelected, RelativeSource={RelativeSource Self}}"/>
                                                <Setter Property="Margin" Value="1,3,3,0"/>
                                                <Setter Property="VerticalAlignment" Value="Top"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <StackPanel>
                                                                <Grid x:Name="TileHost" Tag="{DynamicResource SeleneAmbientMotionEnabled}">
                                                                    <Grid.LayoutTransform><ScaleTransform x:Name="TileScale" ScaleX="1" ScaleY="1"/></Grid.LayoutTransform>
                                                                    <Border x:Name="Tile" Margin="7" Width="160" Height="160" CornerRadius="14" BorderThickness="0" BorderBrush="{DynamicResource SeleneFocusBrush}" ClipToBounds="False" Background="{DynamicResource SeleneInk15Brush}">
                                                                        <Border.Effect>
                                                                            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.55" Color="Black"/>
                                                                        </Border.Effect>
                                                                        <Grid>
                                                                            <!-- the cover and the square art are filled by Selene Core (TileCovers), decoded off the UI thread -->
                                                                            <Border x:Name="SeleneCoverFace" CornerRadius="12">
                                                                                <!-- (a Loaded trigger: WPF tells only elements listening in XAML that they loaded, and Selene Core waits for it) -->
                                                                                <Border.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0" FillBehavior="Stop"/></Storyboard></BeginStoryboard></EventTrigger></Border.Triggers>
                                                                                <Border.Background>
                                                                                    <ImageBrush Stretch="UniformToFill" AlignmentY="Top"/>
                                                                                </Border.Background>
                                                                            </Border>
                                                                            <!-- square tile art from Selene's media folder; the cover stays underneath as the fallback -->
                                                                            <TextBlock x:Name="SquarePath" Tag="{DynamicResource SeleneSquareRoot}" Visibility="Collapsed">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Text">
                                                                                            <Setter.Value>
                                                                                                <MultiBinding StringFormat="{}{0}\Square\{1}.jpg">
                                                                                                    <Binding RelativeSource="{RelativeSource Self}" Path="Tag"/>
                                                                                                    <Binding Path="Id"/>
                                                                                                </MultiBinding>
                                                                                            </Setter.Value>
                                                                                        </Setter>
                                                                                        <!-- no such art at all (a new install), or no Selene Core: nothing to look up (each missing file was a warning in Playnite's log) -->
                                                                                        <Style.Triggers>
                                                                                            <Trigger Property="Tag" Value=""><Setter Property="Text" Value=""/></Trigger>
                                                                                            <Trigger Property="Tag" Value="{x:Null}"><Setter Property="Text" Value=""/></Trigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                            <Border x:Name="SeleneSquareFace" CornerRadius="12">
                                                                                <Border.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0" FillBehavior="Stop"/></Storyboard></BeginStoryboard></EventTrigger></Border.Triggers>
                                                                                <Border.Background>
                                                                                    <ImageBrush Stretch="UniformToFill"/>
                                                                                </Border.Background>
                                                                            </Border>
                                                                            <!-- Selene Core plays the selected tile's trailer here -->
                                                                            <Grid x:Name="TileVideoHost" IsHitTestVisible="False"/>
                                                                            <!-- the glint sweeping over the focused tile: always light (in the focus color it was invisible in themes with a dark or colored focus) -->
                                                                            <Border x:Name="Shine" CornerRadius="12" Opacity="0" IsHitTestVisible="False" Background="White">
                                                                                <Border.OpacityMask>
                                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.6">
                                                                                        <LinearGradientBrush.RelativeTransform><TranslateTransform x:Name="ShineShift" X="-1.5"/></LinearGradientBrush.RelativeTransform>
                                                                                        <GradientStop Color="#00FFFFFF" Offset="0.2"/>
                                                                                        <GradientStop Color="#0AFFFFFF" Offset="0.38"/>
                                                                                        <GradientStop Color="#2EFFFFFF" Offset="0.5"/>
                                                                                        <GradientStop Color="#0AFFFFFF" Offset="0.62"/>
                                                                                        <GradientStop Color="#00FFFFFF" Offset="0.8"/>
                                                                                    </LinearGradientBrush>
                                                                                </Border.OpacityMask>
                                                                            </Border>
                                                                            <Border x:Name="CardFace" CornerRadius="12" Background="{DynamicResource SeleneGlassBrush}" BorderBrush="{DynamicResource SeleneInk15Brush}" BorderThickness="1" Visibility="Collapsed">
                                                                                <Grid>
                                                                                <TextBlock x:Name="CardGlyph" FontFamily="Segoe MDL2 Assets" FontSize="56" Foreground="{DynamicResource SeleneInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                <!-- (a card whose mark is a Material icon: the trophy) -->
                                                                                <TextBlock x:Name="CardIcon" FontFamily="{DynamicResource SeleneIconFont}" FontSize="60" Foreground="{DynamicResource SeleneInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                                                                </Grid>
                                                                            </Border>
                                                                        </Grid>
                                                                    </Border>
                                                                    <!-- selection ring with a highlight travelling around it -->
                                                                    <Border x:Name="Ring" Margin="0" CornerRadius="19" BorderThickness="3" Opacity="0" IsHitTestVisible="False" BorderBrush="{DynamicResource SeleneFocusBrush}">
                                                                        <Border.Effect><DropShadowEffect x:Name="RingGlow" Color="{DynamicResource SeleneFocusColor}" BlurRadius="16" ShadowDepth="0" Opacity="0.25"/></Border.Effect>
                                                                        <Border.OpacityMask>
                                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                                <LinearGradientBrush.RelativeTransform><RotateTransform x:Name="RingSpin" CenterX="0.5" CenterY="0.5" Angle="0"/></LinearGradientBrush.RelativeTransform>
                                                                                <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                                                                <GradientStop Color="#E6FFFFFF" Offset="0.25"/>
                                                                                <GradientStop Color="#99FFFFFF" Offset="0.5"/>
                                                                                <GradientStop Color="#E6FFFFFF" Offset="0.75"/>
                                                                                <GradientStop Color="#FFFFFFFF" Offset="1"/>
                                                                            </LinearGradientBrush>
                                                                        </Border.OpacityMask>
                                                                    </Border>
                                                                    <!-- trailer sound state (R3) -->
                                                                    <Border x:Name="SoundBadge" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,15,15" Width="26" Height="26" CornerRadius="13" Background="{DynamicResource SeleneScrim45Brush}" BorderBrush="{DynamicResource SeleneInk25Brush}" BorderThickness="1" IsHitTestVisible="False">
                                                                        <TextBlock x:Name="SoundGlyph" Text="&#xE74F;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource SeleneInk90Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </Grid>
                                                                <Canvas Height="44" ClipToBounds="False">
                                                                    <TextBlock x:Name="TileName" Text="{Binding DisplayName}" Visibility="Collapsed" Foreground="{DynamicResource SeleneInkBrush}" FontSize="22"
                                                                               FontFamily="{DynamicResource FontMain}" Canvas.Top="14" Canvas.Left="2" Width="420" TextTrimming="CharacterEllipsis"/>
                                                                </Canvas>
                                                            </StackPanel>
                                                            <ControlTemplate.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                                        <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                                        <Condition Binding="{Binding Tag, ElementName=TileHost}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <MultiDataTrigger.EnterActions>
                                                                        <BeginStoryboard x:Name="TileFx">
                                                                            <Storyboard>
                                                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShineShift" Storyboard.TargetProperty="X" RepeatBehavior="Forever" Timeline.DesiredFrameRate="30">
                                                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-1.5"/>
                                                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.6" Value="-1.5"/>
                                                                                    <EasingDoubleKeyFrame KeyTime="0:0:2.4" Value="1.5"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:5" Value="1.5"/>
                                                                                </DoubleAnimationUsingKeyFrames>
                                                                                <DoubleAnimation Storyboard.TargetName="RingSpin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:5" RepeatBehavior="Forever" Timeline.DesiredFrameRate="30"/>
                                                                                <DoubleAnimation Storyboard.TargetName="RingGlow" Storyboard.TargetProperty="Opacity" From="0.2" To="0.55" Duration="0:0:1.8" AutoReverse="True" RepeatBehavior="Forever" Timeline.DesiredFrameRate="30">
                                                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </MultiDataTrigger.EnterActions>
                                                                    <MultiDataTrigger.ExitActions>
                                                                        <RemoveStoryboard BeginStoryboardName="TileFx"/>
                                                                    </MultiDataTrigger.ExitActions>
                                                                </MultiDataTrigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Trigger.EnterActions>

                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1.3" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                                                                <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1.3" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </Trigger.EnterActions>
                                                                    <Trigger.ExitActions>

                                                                        <!-- the same timing and curve as growing: the tile shrinks exactly as much as the next one grows,
                                                                             so the tiles after them stay put (different curves made the whole row bounce) -->
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                                                                <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </Trigger.ExitActions>
                                                                    <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                                                                    <Setter TargetName="Shine" Property="Opacity" Value="1"/>
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding}" Value="nav:library">
                                                                    <Setter TargetName="CardFace" Property="Visibility" Value="Visible"/>
                                                                    <Setter TargetName="CardGlyph" Property="Text" Value="&#xE8F1;"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding}" Value="nav:store">
                                                                    <Setter TargetName="CardFace" Property="Visibility" Value="Visible"/>
                                                                    <Setter TargetName="CardGlyph" Property="Text" Value="&#xE719;"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding}" Value="nav:activity">
                                                                    <Setter TargetName="CardFace" Property="Visibility" Value="Visible"/>
                                                                    <Setter TargetName="CardGlyph" Property="Text" Value="&#xE9D9;"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding}" Value="nav:captures">
                                                                    <Setter TargetName="CardFace" Property="Visibility" Value="Visible"/>
                                                                    <Setter TargetName="CardGlyph" Property="Text" Value="&#xEB9F;"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding}" Value="nav:surprise">
                                                                    <Setter TargetName="CardFace" Property="Visibility" Value="Visible"/>
                                                                    <Setter TargetName="CardGlyph" Property="Text" Value="&#xE8B1;"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding}" Value="nav:news">
                                                                    <Setter TargetName="CardFace" Property="Visibility" Value="Visible"/>
                                                                    <Setter TargetName="CardIcon" Property="Visibility" Value="Visible"/>
                                                                    <Setter TargetName="CardIcon" Property="Text" Value="&#xEB81;"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding}" Value="nav:achievements">
                                                                    <Setter TargetName="CardFace" Property="Visibility" Value="Visible"/>
                                                                    <Setter TargetName="CardIcon" Property="Visibility" Value="Visible"/>
                                                                    <Setter TargetName="CardIcon" Property="Text" Value="&#xEA23;"/>
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsSelected" Value="True"><Setter Property="Panel.ZIndex" Value="10"/></Trigger>
                                                    <DataTrigger Binding="{Binding Hidden}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>

                                            <!-- Play / Details / Favourite pills (focused = white) -->
                                            <ControlTemplate x:Key="SelenePill" TargetType="Button">
                                                <Grid RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                                                    <Grid.RenderTransform><ScaleTransform x:Name="PillScale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                                                    <Border x:Name="Glow" CornerRadius="26" Background="{DynamicResource SeleneFocusBrush}" Opacity="0"><Border.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="22" Color="{DynamicResource SeleneFocusColor}" Opacity="0.4"/></Border.Effect></Border>
                                                    <Border x:Name="Pill" CornerRadius="26" Height="52" MinWidth="{TemplateBinding MinWidth}" Padding="{TemplateBinding Padding}" Background="{DynamicResource SeleneGlassBrush}" BorderBrush="{DynamicResource SeleneInk15Brush}" BorderThickness="1">
                                                        <!-- the label inherits the Button's own Foreground (logical tree), not the presenter's: set it there -->
                                                        <ContentPresenter x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsKeyboardFocused" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource SeleneInkBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SeleneFocusBrush}"/>
                                                        <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource SeleneFocusBrush}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource SeleneOnFocusBrush}"/>
                                                        <Setter TargetName="Glow" Property="Opacity" Value="1"/>
                                                        <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="PillScale" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetName="PillScale" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.15"/>
                                                        </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                                        <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="PillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetName="PillScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                                                        </Storyboard></BeginStoryboard></Trigger.ExitActions>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Grid.Resources>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="270"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- game row (Selene Core fills it, keeps the selection's slot, plays trailers) -->
                                        <Grid x:Name="SeleneRowIntro" Grid.Row="0" RenderTransformOrigin="0.5,0.3">
                                            <Grid.RenderTransform><ScaleTransform x:Name="SeleneRowIntroScale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                                            <ListBoxEx x:Name="SeleneGameRow" Margin="-88,10,-80,-70" Tag="{DynamicResource SeleneRowMode}"
                                                       SelectedIndex="1"
                                                       ItemContainerStyle="{StaticResource SeleneTileStyle}"
                                                       pbeh:FocusBahaviors.OnVisibilityFocus="True"
                                                       Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}"
                                                       ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                       ScrollViewer.CanContentScroll="True"
                                                       VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard" VirtualizingPanel.CacheLengthUnit="Item" VirtualizingPanel.CacheLength="1,2"
                                                       KeyboardNavigation.DirectionalNavigation="Continue">
                                                <ListBoxEx.ItemsSource>
                                                    <CompositeCollection>
                                                        <!-- the section cards (Selene Core drops the ones switched off and keeps the saved order) -->
                                                        <sys:String>nav:captures</sys:String>
                                                        <sys:String>nav:activity</sys:String>
                                                        <sys:String>nav:achievements</sys:String>
                                                        <sys:String>nav:surprise</sys:String>
                                                        <sys:String>nav:news</sys:String>
                                                        <sys:String>nav:store</sys:String>
                                                        <sys:String>nav:library</sys:String>
                                                        <CollectionContainer Collection="{Binding Source={StaticResource SeleneGames}}"/>
                                                    </CompositeCollection>
                                                </ListBoxEx.ItemsSource>
                                                <ListBoxEx.InputBindings>
                                                    <KeyBinding Key="Enter" Command="{Binding ActivateSelectedCommand}"/>
                                                </ListBoxEx.InputBindings>
                                                <ListBoxEx.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <VirtualizingStackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ListBoxEx.ItemsPanel>
                                            </ListBoxEx>
                                            <!-- selected game's name; placed under the selected tile by Selene Core -->
                                            <Canvas IsHitTestVisible="False" ClipToBounds="False">
                                                <TextBlock x:Name="SeleneTileTitle" Foreground="{DynamicResource SeleneInkBrush}" FontSize="22" FontFamily="{DynamicResource FontMain}" Opacity="0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding SelectedItem.DisplayName, ElementName=SeleneGameRow}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedItem, ElementName=SeleneGameRow}" Value="nav:library">
                                                                    <Setter Property="Text" Value="Collection"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding SelectedItem, ElementName=SeleneGameRow}" Value="nav:store">
                                                                    <Setter Property="Text" Value="Store"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding SelectedItem, ElementName=SeleneGameRow}" Value="nav:activity">
                                                                    <Setter Property="Text" Value="Activity"/>
                                                                </DataTrigger>
