<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="d">

    <sys:Boolean x:Key="SeleneAmbientMotionEnabled">True</sys:Boolean>
    <sys:String x:Key="SelenePlatformFallbackGlyph">&#xEA12;</sys:String>
    <Thickness x:Key="SeleneSpotlightLogoMargin">0,-45,0,0</Thickness>
    <sys:Double x:Key="SeleneDetailsBadgeWidth">48</sys:Double>

    <Stretch x:Key="SeleneBackgroundStretch">UniformToFill</Stretch>

    <!-- Google's Material Icons, for the menus Playnite builds (game options, its settings) -->
    <FontFamily x:Key="FontMaterialIcons">./Fonts/#Material Icons</FontFamily>
    <!-- Selene's display font, for every window (it lived in the main screen only: the game menu, dialogs and settings
         fell back to Playnite's font setting) -->
    <FontFamily x:Key="FontMain">Segoe UI Variable Display, Segoe UI</FontFamily>

    <!-- the button names in the hints: Selene Core swaps them for PlayStation's when Playnite's "Button prompts" says so -->
    <sys:String x:Key="SelenePromptA">A</sys:String>
    <sys:String x:Key="SelenePromptB">B</sys:String>
    <sys:String x:Key="SelenePromptX">X</sys:String>
    <sys:String x:Key="SelenePromptY">Y</sys:String>
    <sys:String x:Key="SelenePromptLB">LB</sys:String>
    <sys:String x:Key="SelenePromptRB">RB</sys:String>
    <sys:String x:Key="SelenePromptLT">LT</sys:String>
    <sys:String x:Key="SelenePromptRT">RT</sys:String>

    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="GlyphColor">#FF9CCBFF</Color>  <!-- Selene: moonlight blue -->
    <Color x:Key="GlyphLightColor">#FFEAF3FF</Color>
    <Color x:Key="SelectionLightColor">#FFB8C7DD</Color>
    <Color x:Key="OverlayColor">#CC03081A</Color>
    
    <Color x:Key="ControlBackgroundColor">#FF1A2A4A</Color>
    <Color x:Key="ControlBackgroundColorDark">#FF0A142C</Color>

    <Color x:Key="TextColor">#FFEBEBEB</Color>
    <Color x:Key="TextColorDark">#FF757575</Color>

    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="GlyphLightBrush" Color="{DynamicResource GlyphLightColor}" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{DynamicResource ControlBackgroundColor}" />
    <SolidColorBrush x:Key="ControlBackgroundDarkBrush" Color="{DynamicResource ControlBackgroundColorDark}" />
    <SolidColorBrush x:Key="SelectionLightBrush" Color="{DynamicResource SelectionLightColor}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="{DynamicResource OverlayColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{DynamicResource ControlBackgroundColorDark}" />

    <!-- Selene's own keys (every color theme in Palettes\ overrides the colors; the brushes follow) -->
    <Color x:Key="SeleneFocusColor">#FFFFFFFF</Color>      <!-- focused fill, rings, glows -->
    <Color x:Key="SeleneOnFocusColor">#FF111111</Color>    <!-- text on a focused fill -->
    <Color x:Key="SeleneInkColor">#FFFFFFFF</Color>        <!-- text and icons over game art -->
    <Color x:Key="SeleneScrimColor">#FF000000</Color>      <!-- darkens art under text (lightens it in light themes) -->
    <Color x:Key="SeleneGlassColor">#FF14181F</Color>      <!-- glass panels and cards -->
    <Color x:Key="SeleneSuccessColor">#FF3DDC84</Color>

    <SolidColorBrush x:Key="SeleneFocusBrush" Color="{DynamicResource SeleneFocusColor}" />
    <SolidColorBrush x:Key="SeleneOnFocusBrush" Color="{DynamicResource SeleneOnFocusColor}" />
    <SolidColorBrush x:Key="SeleneInkBrush" Color="{DynamicResource SeleneInkColor}" />
    <SolidColorBrush x:Key="SeleneInk90Brush" Color="{DynamicResource SeleneInkColor}" Opacity="0.9" />
    <SolidColorBrush x:Key="SeleneInk60Brush" Color="{DynamicResource SeleneInkColor}" Opacity="0.6" />
    <SolidColorBrush x:Key="SeleneInk25Brush" Color="{DynamicResource SeleneInkColor}" Opacity="0.25" />
    <SolidColorBrush x:Key="SeleneInk15Brush" Color="{DynamicResource SeleneInkColor}" Opacity="0.15" />
    <SolidColorBrush x:Key="SeleneScrimBrush" Color="{DynamicResource SeleneScrimColor}" />
    <SolidColorBrush x:Key="SeleneScrim65Brush" Color="{DynamicResource SeleneScrimColor}" Opacity="0.65" />
    <SolidColorBrush x:Key="SeleneScrim45Brush" Color="{DynamicResource SeleneScrimColor}" Opacity="0.45" />
    <SolidColorBrush x:Key="SeleneGlassBrush" Color="{DynamicResource SeleneGlassColor}" Opacity="0.75" />
    <SolidColorBrush x:Key="SeleneGlassSolidBrush" Color="{DynamicResource SeleneGlassColor}" Opacity="0.88" />
    <SolidColorBrush x:Key="SeleneGlassLightBrush" Color="{DynamicResource SeleneGlassColor}" Opacity="0.45" />
    <SolidColorBrush x:Key="SeleneSuccessBrush" Color="{DynamicResource SeleneSuccessColor}" />
    <sys:String x:Key="SeleneStatGames">-</sys:String>
    <sys:String x:Key="SeleneStatInstalled">-</sys:String>
    <sys:String x:Key="SeleneStatRecent">-</sys:String>
    <sys:String x:Key="SeleneStatStores">-</sys:String>
    <!-- the Store card (Selene Core sets these when its Store page is on) -->
    <sys:String x:Key="SeleneStoreHeadline">Store</sys:String>
    <sys:String x:Key="SeleneStoreAbout">Find something new in the store apps on this PC. Selene is here when you come back.</sys:String>
    <sys:String x:Key="SeleneHeartGlyph">&#xE006;</sys:String>
    <!-- home background: the game's art over the wallpaper (Selene Core sets 0 for a profile that wants the wallpaper only) -->
    <sys:Double x:Key="SeleneArtOpacity">1</sys:Double>
    <DropShadowEffect x:Key="SeleneFocusGlow" ShadowDepth="0" BlurRadius="18" Color="{DynamicResource SeleneFocusColor}" Opacity="0.35" />
    <DropShadowEffect x:Key="SeleneFocusGlowStrong" ShadowDepth="0" BlurRadius="18" Color="{DynamicResource SeleneFocusColor}" Opacity="0.55" />
    <sys:Double x:Key="FontSizeSmall">18</sys:Double>
    <sys:Double x:Key="FontSize">22</sys:Double>

    <sys:Double x:Key="FilterPanelWidth">300</sys:Double>
    
    <GridLength x:Key="ProgressWindowWidth">640</GridLength>
    
    <Style x:Key="TextBlockBaseStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <!-- Selene's own backdrop: deep navy, a little lighter top-left where the light comes in (Selene Core adds the beam
         and the drifting particles over it) -->
    <!-- Playnite's progress window paints itself with "MainBackgourndBrush" (Playnite's spelling) for a frame before Selene
         turns it into a notification card: see-through, so no dark frame flashes over the screen. Selene's own backdrop is
         SeleneBaseBrush. -->
    <SolidColorBrush x:Key="MainBackgourndBrush" Color="Transparent" />
    <LinearGradientBrush x:Key="SeleneBaseBrush" StartPoint="0,0" EndPoint="1,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#FF17244A" Offset="0" />
            <GradientStop Color="#FF0C142C" Offset="0.45" />
            <GradientStop Color="#FF05080F" Offset="1.0" />
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1,0.5" >
        <GradientStop Color="#FF091F51" Offset="0"/>
        <GradientStop Color="#AA0B1027" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BottomBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1.5,1" >
        <GradientStop Color="#FF091F51" Offset="0"/>
        <GradientStop Color="#AA0B1027" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Playnite's own pop-up menus (edit fields, extensions, notifications...): Selene's dark glass, not Playnite's blue -->
    <SolidColorBrush x:Key="OverlayMenuBackgroundBrush" Color="{DynamicResource SeleneGlassColor}" Opacity="0.97" />

    <LinearGradientBrush x:Key="SelectionBrush" StartPoint="0.5,-0.5" EndPoint="1,1.5" >
        <GradientStop Color="{DynamicResource SeleneFocusColor}" Offset="0"/>
        <GradientStop Color="{DynamicResource GlyphColor}" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GameDetailsBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,0.4" >
        <GradientStop Color="#00091F51" Offset="0.0"/>
        <GradientStop Color="#EE0B1027" Offset="0.8"/>
    </LinearGradientBrush>
    
    <SolidColorBrush x:Key="WarningBrush" Color="#ff6b6b" />
</ResourceDictionary>
