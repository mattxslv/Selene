                                                            <TextBlock Text="{DynamicResource SeleneStatAchBronze}" Foreground="{DynamicResource SeleneInkBrush}" FontSize="21" FontFamily="{DynamicResource FontMain}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel x:Name="SeleneAchievementsShowcase" Orientation="Horizontal" Margin="10,28,-80,10" HorizontalAlignment="Left"/>
                                            </StackPanel>
                                            <!-- the store card selected: what it is, a few numbers, what A does -->
                                            <!-- (wide: the showcase's big pictures go right across; the text keeps its own width) -->
                                            <StackPanel Margin="0,40,0,0" HorizontalAlignment="Left" Width="1760" Opacity="0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=SeleneGameRow}" Value="nav:store">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.12" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                                <DataTrigger.ExitActions>
                                                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0"/></Storyboard></BeginStoryboard>
                                                                </DataTrigger.ExitActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <!-- what's on now, taking turns (free games, the biggest sale, new, ending soon...; Selene Core shows that
                                                     game's art behind the card); "Store" is the card's own name -->
                                                <StackPanel x:Name="SeleneStoreHead" Width="1000" HorizontalAlignment="Left" Margin="0,40,0,0">
                                                    <TextBlock Text="{DynamicResource SeleneStoreHeadline}" Foreground="{DynamicResource SeleneInkBrush}" FontSize="60" FontFamily="{DynamicResource FontMain}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{DynamicResource SeleneStoreAbout}" Foreground="{DynamicResource SeleneInk90Brush}" FontSize="22" FontFamily="{DynamicResource FontMain}" TextWrapping="Wrap" HorizontalAlignment="Left" Margin="2,10,0,0"/>
                                                </StackPanel>
                                                <!-- the store apps on this PC as chips with their logos (Selene Core; the plain list without it) -->
                                                <TextBlock x:Name="SeleneStoreNames" Text="{DynamicResource SeleneStatStores}" Foreground="{DynamicResource SeleneInk60Brush}" FontSize="18" FontFamily="{DynamicResource FontMain}" Margin="2,20,0,0"/>
                                                <StackPanel x:Name="SeleneStoreChips" Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Left"/>
                                                <!-- this week's free games and the biggest sales, as pictures with their price (Selene Core) -->
                                                <!-- (room on the right: four pictures are wider than the card, and a strip that overflows gets clipped to its
                                                     slot, which cut off the picked picture as it grew and its ring) -->
                                                <StackPanel x:Name="SeleneStoreShowcase" Orientation="Horizontal" Margin="10,28,-80,10" HorizontalAlignment="Left"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,30,0,0" HorizontalAlignment="Left" Width="900">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=SeleneGameRow}" Value="nav:library">
                                                                <Setter Property="Visibility" Value="Hidden"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=SeleneGameRow}" Value="nav:store">
                                                                <Setter Property="Visibility" Value="Hidden"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=SeleneGameRow}" Value="nav:activity">
                                                                <Setter Property="Visibility" Value="Hidden"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=SeleneGameRow}" Value="nav:captures">
                                                                <Setter Property="Visibility" Value="Hidden"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=SeleneGameRow}" Value="nav:surprise">
                                                                <Setter Property="Visibility" Value="Hidden"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=SeleneGameRow}" Value="nav:news">
                                                                <Setter Property="Visibility" Value="Hidden"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=SeleneGameRow}" Value="nav:achievements">
                                                                <Setter Property="Visibility" Value="Hidden"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock x:Name="SeleneLogoPath" Tag="{Api Paths.ConfigurationPath}" Visibility="Collapsed">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0}\ExtraMetadata\games\{1}\logo.png">
                                                            <Binding RelativeSource="{RelativeSource Self}" Path="Tag"/>
                                                            <Binding Path="SelectedGame.Id"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <Grid Height="170" HorizontalAlignment="Left">
                                                    <Image x:Name="SeleneLogo" Source="{Binding ElementName=SeleneLogoPath, Path=Text, Converter={StaticResource ImageStringToImageConverter}, NotifyOnTargetUpdated=True}"
                                                           MaxWidth="620" MaxHeight="215" Margin="{DynamicResource SeleneSpotlightLogoMargin}" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Bottom" RenderOptions.BitmapScalingMode="Fant">
                                                        <Image.RenderTransform><TranslateTransform x:Name="LogoShift" X="0"/></Image.RenderTransform>
                                                        <Image.Triggers>
                                                            <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="0"/>
                                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.7" Value="1"/>
                                                                        </DoubleAnimationUsingKeyFrames>
                                                                        <DoubleAnimation Storyboard.TargetName="LogoShift" Storyboard.TargetProperty="X" From="-30" To="0" BeginTime="0:0:0.3" Duration="0:0:0.4">
                                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                        </Image.Triggers>
                                                    </Image>
                                                    <!-- no logo: the name as text -->
                                                    <TextBlock Text="{Binding SelectedGame.DisplayName}" Foreground="{DynamicResource SeleneInkBrush}" FontSize="56" FontFamily="{DynamicResource FontMain}"
                                                               VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ElementName=SeleneLogo, Path=Source}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>

                                                <!-- running: "now playing" chip -->
                                                <Border HorizontalAlignment="Left" Margin="2,24,0,0" CornerRadius="19" Padding="12,6,18,7" Background="{DynamicResource SeleneGlassLightBrush}" BorderBrush="{DynamicResource SeleneInk25Brush}" BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedGame.IsRunning}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Grid Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,9,0">
                                                            <Ellipse Fill="{DynamicResource SeleneSuccessBrush}" Opacity="0.35" RenderTransformOrigin="0.5,0.5">
                                                                <Ellipse.RenderTransform><ScaleTransform ScaleX="0.5" ScaleY="0.5"/></Ellipse.RenderTransform>
                                                                <Ellipse.Triggers>
                                                                    <EventTrigger RoutedEvent="Loaded">
                                                                        <BeginStoryboard>
                                                                            <Storyboard RepeatBehavior="Forever">
                                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="0.5" To="1" Duration="0:0:1.4"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="0.5" To="1" Duration="0:0:1.4"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.45" To="0" Duration="0:0:1.4"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </EventTrigger>
                                                                </Ellipse.Triggers>
                                                            </Ellipse>
                                                            <Ellipse Width="9" Height="9" Fill="{DynamicResource SeleneSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <TextBlock Text="NOW PLAYING" Foreground="{DynamicResource SeleneSuccessBrush}" FontSize="14" FontWeight="Bold" FontFamily="{DynamicResource FontMain}" VerticalAlignment="Center"/>
                                                        <Border Width="1" Height="18" Background="{DynamicResource SeleneInk25Brush}" Margin="14,0,14,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Continue where you left off" Foreground="{DynamicResource SeleneInk90Brush}" FontSize="17" FontFamily="{DynamicResource FontMain}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>

                                                <StackPanel Orientation="Horizontal" Margin="2,18,0,0">
                                                    <Button x:Name="SelenePlayBtn" Template="{StaticResource SelenePill}" MinWidth="180" Padding="36,0" Height="60" Margin="0,0,14,0"
                                                            VerticalAlignment="Center" Focusable="True" FocusVisualStyle="{x:Null}" Cursor="Hand">
                                                        <TextBlock FontSize="21" FontFamily="{DynamicResource FontMain}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="Play"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedGame.IsRunning}" Value="True"><Setter Property="Text" Value="Resume"/></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button>
                                                    <Button x:Name="SeleneDetailsBtn" Template="{StaticResource SelenePill}" MinWidth="180" Padding="36,0" Height="60"
                                                            VerticalAlignment="Center" Focusable="True" FocusVisualStyle="{x:Null}" Cursor="Hand">
                                                        <TextBlock FontSize="21" FontFamily="{DynamicResource FontMain}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="Details"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedGame.IsRunning}" Value="True"><Setter Property="Text" Value="Close Game"/></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button>
                                                    <Button x:Name="SeleneFavBtn" ToolTip="Favorite" Template="{StaticResource SelenePill}" MinWidth="52" Width="52" Padding="0" Height="60" Margin="14,0,0,0"
                                                            VerticalAlignment="Center" Focusable="True" FocusVisualStyle="{x:Null}" Cursor="Hand">
                                                        <!-- the signed-in profile's favorite (Selene Core sets the glyph) -->
                                                        <TextBlock FontSize="20" FontFamily="Segoe MDL2 Assets" Text="{DynamicResource SeleneHeartGlyph}"/>
                                                    </Button>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Margin="4,26,0,0">
                                                    <StackPanel Margin="0,0,26,0">
                                                        <TextBlock Text="PLAYTIME" Foreground="{DynamicResource SeleneInk60Brush}" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                                        <TextBlock Text="{Binding SelectedGame.Playtime, Mode=OneWay, Converter={StaticResource PlayTimeToStringConverter}}" Foreground="{DynamicResource SeleneInkBrush}" FontSize="21" FontFamily="{DynamicResource FontMain}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Rectangle Width="1" Fill="{DynamicResource SeleneInk25Brush}" Margin="0,4,26,4"/>
                                                    <StackPanel Margin="0,0,26,0">
                                                        <TextBlock Text="LAST PLAYED" Foreground="{DynamicResource SeleneInk60Brush}" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                                        <TextBlock Text="{DynamicResource SeleneLastPlayed}" Foreground="{DynamicResource SeleneInkBrush}" FontSize="21" FontFamily="{DynamicResource FontMain}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Rectangle Width="1" Fill="{DynamicResource SeleneInk25Brush}" Margin="0,4,26,4"/>
                                                    <StackPanel>
                                                        <TextBlock Text="PLATFORM" Foreground="{DynamicResource SeleneInk60Brush}" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <Grid Width="22" Height="22" Margin="0,0,9,0" VerticalAlignment="Center">
                                                <Path Data="{DynamicResource SelenePlatformIcon}" Fill="{DynamicResource SeleneInkBrush}" Stretch="Uniform"/>
                                                <TextBlock Text="{DynamicResource SelenePlatformFallbackGlyph}" FontFamily="{DynamicResource SeleneIconFont}" FontSize="21" Foreground="{DynamicResource SeleneInkBrush}" VerticalAlignment="Center" Visibility="{DynamicResource SelenePlatformFallback}"/>
                                            </Grid>
                                                            <TextBlock Text="{DynamicResource SelenePlatformName}" Foreground="{DynamicResource SeleneInkBrush}" FontSize="21" FontFamily="{DynamicResource FontMain}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <!-- how long it takes to beat (the HowLongToBeat add-on, when it has a time for this game; Selene's "HowLongToBeat times" switch) -->
                                                    <StackPanel x:Name="SeleneHltbStatHub" Orientation="Horizontal">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=HowLongToBeat, Path=HasData}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=HowLongToBeat, Path=MainStory}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <Rectangle Width="1" Fill="{DynamicResource SeleneInk25Brush}" Margin="26,4,26,4"/>
                                                        <StackPanel>
                                                            <TextBlock Text="TIME TO BEAT" Foreground="{DynamicResource SeleneInk60Brush}" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                                            <TextBlock Text="{PluginSettings Plugin=HowLongToBeat, Path=MainStoryFormat}" Foreground="{DynamicResource SeleneInkBrush}" FontSize="21" FontFamily="{DynamicResource FontMain}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <!-- achievements (Playnite Achievements): the count and a thin bar -->
                                                    <StackPanel x:Name="SeleneAchievementsStatHub" Orientation="Horizontal">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{PluginSettings Plugin=PlayniteAchievements, Path=HasData, FallbackValue=False}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <Rectangle Width="1" Fill="{DynamicResource SeleneInk25Brush}" Margin="26,4,26,4"/>
                                                        <StackPanel>
                                                            <TextBlock Text="ACHIEVEMENTS" Foreground="{DynamicResource SeleneInk60Brush}" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Text="&#xEA23;" FontFamily="{DynamicResource SeleneIconFont}" FontSize="20" Foreground="{DynamicResource GlyphBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                                <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=Unlocked, FallbackValue='-'}" Foreground="{DynamicResource SeleneInkBrush}" FontSize="21" FontFamily="{DynamicResource FontMain}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                <TextBlock Text=" / " Foreground="{DynamicResource SeleneInk60Brush}" FontSize="21" FontFamily="{DynamicResource FontMain}" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=Total, FallbackValue='-'}" Foreground="{DynamicResource SeleneInk60Brush}" FontSize="21" FontFamily="{DynamicResource FontMain}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <ProgressBar Value="{PluginSettings Plugin=PlayniteAchievements, Path=Percent, FallbackValue=0}" Maximum="100" Height="4" Width="130" HorizontalAlignment="Left" Margin="0,5,0,0" Focusable="False">
                                                                <ProgressBar.Template>
                                                                    <ControlTemplate TargetType="ProgressBar">
                                                                        <Grid>
                                                                            <Border x:Name="PART_Track" CornerRadius="2" Background="{DynamicResource SeleneInk25Brush}"/>
                                                                            <Border x:Name="PART_Indicator" CornerRadius="2" Background="{DynamicResource GlyphBrush}" HorizontalAlignment="Left"/>
                                                                        </Grid>
                                                                    </ControlTemplate>
                                                                </ProgressBar.Template>
                                                            </ProgressBar>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>

                                    <!-- the selected game's screenshots (Selene Core publishes SeleneShot0-5 / SeleneShotsNone); A opens the viewer -->
                                    <Grid x:Name="HubBottomCards" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="80,34,0,0" RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform><TranslateTransform x:Name="HubBottomCardsShift" Y="0"/></Grid.RenderTransform>
                                        <Grid.Resources>
                                            <Style x:Key="SeleneShotTileStyle" TargetType="ButtonEx">
                                                <Setter Property="Focusable" Value="True"/>
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                <Setter Property="Margin" Value="0,0,22,0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ButtonEx">
                                                            <Grid RenderTransformOrigin="0.5,0.5">
                                                                <Grid.RenderTransform><ScaleTransform x:Name="TileScale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                                                                <Border Width="448" Height="252" CornerRadius="14" Background="{DynamicResource SeleneGlassSolidBrush}" ClipToBounds="True">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <Border x:Name="TileRing" CornerRadius="17" Margin="-4" BorderBrush="{DynamicResource SeleneFocusBrush}" BorderThickness="3" Opacity="0" IsHitTestVisible="False"/>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                                    <Setter TargetName="TileRing" Property="Opacity" Value="1"/>
                                                                    <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.15"/>
                                                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.15"/>
                                                                    </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                                                    <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                                                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                                                                    </Storyboard></BeginStoryboard></Trigger.ExitActions>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Grid.Resources>
                                        <StackPanel>
                                            <TextBlock Text="No screenshots for this game" FontSize="18" FontFamily="Segoe UI" Foreground="{DynamicResource SeleneInk60Brush}" Visibility="{DynamicResource SeleneShotsNone}"/>
                                            <!-- (the room for the focused tile's ring and growth is inside the strip's content: a padding on the scroller
                                                 sat outside its clip, so the first tile's ring was cut) -->
                                            <ScrollViewer x:Name="SeleneShotStrip" Width="1788" Margin="-14,-14,0,0" Padding="0" Focusable="False" CanContentScroll="False"
                                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                                <StackPanel x:Name="SeleneShotTiles" Orientation="Horizontal" Margin="14">
                                                    <ButtonEx x:Name="SeleneShotTile0" Tag="0" Style="{StaticResource SeleneShotTileStyle}" Visibility="{DynamicResource SeleneShot0Vis}">
                                                        <Image Source="{DynamicResource SeleneShot0}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </ButtonEx>
                                                    <ButtonEx x:Name="SeleneShotTile1" Tag="1" Style="{StaticResource SeleneShotTileStyle}" Visibility="{DynamicResource SeleneShot1Vis}">
                                                        <Image Source="{DynamicResource SeleneShot1}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </ButtonEx>
                                                    <ButtonEx x:Name="SeleneShotTile2" Tag="2" Style="{StaticResource SeleneShotTileStyle}" Visibility="{DynamicResource SeleneShot2Vis}">
                                                        <Image Source="{DynamicResource SeleneShot2}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </ButtonEx>
                                                    <ButtonEx x:Name="SeleneShotTile3" Tag="3" Style="{StaticResource SeleneShotTileStyle}" Visibility="{DynamicResource SeleneShot3Vis}">
                                                        <Image Source="{DynamicResource SeleneShot3}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </ButtonEx>
                                                    <ButtonEx x:Name="SeleneShotTile4" Tag="4" Style="{StaticResource SeleneShotTileStyle}" Visibility="{DynamicResource SeleneShot4Vis}">
                                                        <Image Source="{DynamicResource SeleneShot4}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </ButtonEx>
                                                    <ButtonEx x:Name="SeleneShotTile5" Tag="5" Style="{StaticResource SeleneShotTileStyle}" Visibility="{DynamicResource SeleneShot5Vis}">
                                                        <Image Source="{DynamicResource SeleneShot5}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </ButtonEx>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>

                            <!-- ================= TOP BAR (home + library) ================= -->
                            <Grid x:Name="HubTopBarBackground" VerticalAlignment="Top" Height="110" Margin="64,0,64,0">
                                <!-- home: LB/RB filter tabs (drawn by Selene Core) -->
                                <StackPanel x:Name="SeleneFilterTabs" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <!-- library: Playnite's filter presets, styled like Spotlight's tabs (LB / RB) -->
                                <FilterPresetSelector x:Name="PART_FilterPresetSelector" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <!-- Playnite's notifications: not part of Selene's top bar (the part stays, hidden) -->
                                    <ButtonEx x:Name="PART_ButtonNotifications" VerticalAlignment="Center" Margin="10,0,10,0" Height="48" MinWidth="48" Visibility="Collapsed">
                                        <Button.Content>
                                            <Grid>
                                                <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SeleneInkBrush}" FontSize="26" />
                                                <Ellipse Width="9" Height="9" Fill="{DynamicResource GlyphBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,2,0"/>
                                            </Grid>
                                        </Button.Content>
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ButtonTopMenu}">
                                            </Style>
                                        </Button.Style>
                                    </ButtonEx>
                                    <!-- the menu opens with Start (or Menu); the part stays for Playnite, hidden -->
                                    <ButtonEx x:Name="PART_ButtonMainMenu" VerticalAlignment="Center" Style="{DynamicResource ButtonTopMenu}" Margin="10,0,16,0" Height="48" MinWidth="48" Visibility="Collapsed">
                                        <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SeleneInkBrush}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </ButtonEx>
                                    <!-- what UniPlaySong is playing: a note and the song (Selene Core fills it: NowPlayingBar; the "Show what is playing" switch) -->
                                    <StackPanel x:Name="SeleneNowPlaying" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,28,0" Visibility="Collapsed" IsHitTestVisible="False">
                                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SeleneInk60Brush}" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock x:Name="SeleneNowPlayingText" Foreground="{DynamicResource SeleneInk90Brush}" FontSize="20" FontFamily="{DynamicResource FontMain}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="320" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <!-- the signed-in profile's avatar (Selene Core fills it; the "Profile in the top bar" switch) -->
                                    <Grid x:Name="SeleneTopProfile" VerticalAlignment="Center" Margin="0,0,28,0" Visibility="Collapsed" IsHitTestVisible="False"/>
                                    <TextBlock x:Name="PART_TextClock" Foreground="{DynamicResource SeleneInkBrush}" FontSize="30" FontFamily="{DynamicResource FontMain}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- ================= LOGIN ================= -->
                            <Grid x:Name="AcceuilSettings" Background="{DynamicResource SeleneScrimBrush}">
                                <Grid x:Name="LoginCenterShell"/>
                                <!-- Selene Core builds the login into LoginCenterShell and takes this layer down. Without Core (not
                                     installed, disabled) the layer would stay dark for ever, so this note fades in after a few seconds;
                                     Core collapses it as it starts. -->
                                <StackPanel x:Name="SeleneCoreNotice" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="980" Margin="40">
                                    <StackPanel.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:8" Duration="0:0:0.6">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </StackPanel.Triggers>
                                    <TextBlock Text="Selene Core isn't running" FontFamily="{StaticResource FontMain}" FontSize="42" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SeleneInkBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                                    <TextBlock FontFamily="{StaticResource FontMain}" FontSize="23" Foreground="{DynamicResource SeleneInkBrush}" Opacity="0.85"
                                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,22,0,0" LineHeight="34"
                                               Text="Selene is this theme plus its add-on, Selene Core. Install SeleneCore.pext from github.com/mattxslv/Selene/releases (open the file, or drag it onto Playnite's window), then restart Playnite. If it is installed already, make sure it is enabled under Add-ons."/>
                                    <TextBlock FontFamily="{StaticResource FontMain}" FontSize="19" Foreground="{DynamicResource SeleneInkBrush}" Opacity="0.6"
                                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,22,0,0"
                                               Text="Playnite's menu still opens from here (the Start / Menu button on a controller) to pick another theme meanwhile."/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <GameDetails x:Name="PART_ElemGameDetails" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <GameStatus x:Name="PART_ElemGameStatus" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
