<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <!-- Selene game details: the game's hero art full screen; down the left, the logo, who made it and the scores, the Play /
         Options pills, the facts, the genres as chips and the description on glass. Below, bands Selene Core fills (DetailsStage):
         the game's screenshots, your captures of it with your activity, and more games like it; Down from the pills goes into
         them and the page glides up. -->
    <Style x:Key="SeleneDetailsButton" TargetType="ButtonEx">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Margin" Value="0,0,14,0"/>
        <Setter Property="MinWidth" Value="200"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonEx">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform x:Name="PillScale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                        <Border x:Name="Glow" CornerRadius="26" Background="{DynamicResource SeleneFocusBrush}" Opacity="0">
                            <Border.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="22" Color="{DynamicResource SeleneFocusColor}" Opacity="0.4"/></Border.Effect>
                        </Border>
                        <!-- dark glass, like the home's pills -->
                        <Border x:Name="Pill" CornerRadius="26" Height="52" MinWidth="{TemplateBinding MinWidth}" Padding="36,0" Background="{DynamicResource SeleneGlassBrush}" BorderBrush="{DynamicResource SeleneInk15Brush}" BorderThickness="1">
                            <ContentPresenter x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{DynamicResource SeleneInkBrush}" TextElement.FontSize="21"
                                              TextElement.FontFamily="Segoe UI Variable Display, Segoe UI"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SeleneFocusBrush}"/>
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource SeleneOnFocusBrush}"/>
                            <Setter TargetName="Glow" Property="Opacity" Value="1"/>
                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="PillScale" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="PillScale" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.15"/>
                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="PillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="PillScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SeleneStatLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SeleneInk60Brush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style x:Key="SeleneStatValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SeleneInkBrush}"/>
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>
    <!-- a band's title -->
    <Style x:Key="SeleneBandLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SeleneInkBrush}"/>
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Margin" Value="2,0,0,14"/>
    </Style>
    <!-- a genre / feature as a small chip -->
    <Style x:Key="SeleneChip" TargetType="Border">
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="12,4,12,5"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Background" Value="{DynamicResource SeleneInk15Brush}"/>
    </Style>
    <!-- a score badge, gone when there's no score -->
    <Style x:Key="SeleneScoreBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="10,3,12,4"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="Background" Value="{DynamicResource SeleneGlassBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SeleneInk15Brush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style TargetType="{x:Type GameDetails}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameDetails}">
                    <Grid Background="{DynamicResource SeleneScrimBrush}"
                          x:Name="PART_ViewHost"
                          d:DesignWidth="{StaticResource DesignWidth}"
                          d:DesignHeight="{StaticResource DesignHeight}"
                          d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameIntance}"
                          KeyboardNavigation.DirectionalNavigation="Contained"
                          KeyboardNavigation.TabNavigation="Cycle"
                          KeyboardNavigation.ControlTabNavigation="Cycle">

                        <!-- art: Playnite's background, Selene's hero art over it when there is one -->
                        <FadeImage x:Name="PART_ImageBackground" RenderOptions.BitmapScalingMode="Fant" Stretch="{DynamicResource SeleneBackgroundStretch}"/>
                        <TextBlock x:Name="HeroPath" Tag="{DynamicResource SeleneHeroRoot}" Visibility="Collapsed">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text">
                                        <Setter.Value>
                                            <MultiBinding StringFormat="{}{0}\Hero\{1}.jpg">
                                                <Binding RelativeSource="{RelativeSource Self}" Path="Tag"/>
                                                <Binding Path="Id"/>
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                    <!-- no such art at all (a new install), or no Selene Core: nothing to look up (each missing file was a warning in Playnite's log) -->
                                    <Style.Triggers>
                                        <Trigger Property="Tag" Value=""><Setter Property="Text" Value=""/></Trigger>
                                        <Trigger Property="Tag" Value="{x:Null}"><Setter Property="Text" Value=""/></Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <FadeImage Source="{Binding Text, ElementName=HeroPath}" RenderOptions.BitmapScalingMode="Fant" Stretch="{DynamicResource SeleneBackgroundStretch}"/>
                        <!-- the words' side dark, the bottom dark, a soft vignette at the edges -->
                        <Border Background="{DynamicResource SeleneScrimBrush}">
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#F2000000" Offset="0"/>
                                    <GradientStop Color="#B3000000" Offset="0.5"/>
                                    <GradientStop Color="#26000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                        <Border Background="{DynamicResource SeleneScrimBrush}">
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0.4"/>
                                    <GradientStop Color="#E6000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                        <Border Background="{DynamicResource SeleneScrimBrush}">
                            <Border.OpacityMask>
                                <RadialGradientBrush RadiusX="0.8" RadiusY="0.9">
                                    <GradientStop Color="#00000000" Offset="0.6"/>
                                    <GradientStop Color="#8C000000" Offset="1"/>
                                </RadialGradientBrush>
                            </Border.OpacityMask>
                        </Border>

                        <!-- the page: it glides up as Down goes into the bands below (Selene Core moves SeleneDetailsShift) -->
                        <!-- (tall on purpose: a child placed below the window's height got a slot a few pixels high and was clipped to it) -->
                        <!-- on a canvas: in the screen's own grid the page (taller than the screen) was clipped to the screen in its own
                             coordinates, and the glide couldn't bring the lower bands into view -->
                        <!-- clipped to the screen: the next band peeks in at its foot, cut off, blurred and faded (Selene Core fades the
                             band itself: a mask over this whole grid redrew the entire page on every frame of the glide and made it stutter) -->
                        <Grid ClipToBounds="True">
                        <Canvas>
                        <Grid x:Name="SeleneDetailsPage" Height="1800" Width="{Binding ActualWidth, ElementName=PART_ViewHost}">
                            <Grid.RenderTransform><TranslateTransform x:Name="SeleneDetailsShift" Y="0"/></Grid.RenderTransform>

                            <DockPanel x:Name="SeleneDetailsTop" Margin="110,96,0,0" Width="1060" Height="604" LastChildFill="True" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <!-- logo, or the name when there is none -->
                                <TextBlock DockPanel.Dock="Top" x:Name="LogoPath" Tag="{Api Paths.ConfigurationPath}" Visibility="Collapsed">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}\ExtraMetadata\games\{1}\logo.png">
                                            <Binding RelativeSource="{RelativeSource Self}" Path="Tag"/>
                                            <Binding Path="Id"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <Grid DockPanel.Dock="Top" Height="180" HorizontalAlignment="Left">
                                    <Image x:Name="Logo" Source="{Binding Text, ElementName=LogoPath, Converter={StaticResource ImageStringToImageConverter}}"
                                           MaxWidth="680" MaxHeight="180" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                           RenderOptions.BitmapScalingMode="Fant"/>
                                    <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource SeleneInkBrush}" FontSize="62" FontFamily="Segoe UI Variable Display, Segoe UI"
                                               FontWeight="SemiBold" VerticalAlignment="Bottom" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Source, ElementName=Logo}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- who made it, and the scores -->
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,16,0,0">
                                    <TextBlock x:Name="SeleneDevelopers" FontSize="17" FontFamily="Segoe UI" Foreground="{DynamicResource SeleneInk90Brush}" VerticalAlignment="Center" Margin="0,0,18,0">
                                        <Run Text="{Binding Developers, Converter={StaticResource ListToStringConverter}, Mode=OneWay}"/>
                                    </TextBlock>
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource SeleneScoreBadge}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CriticScore}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="15" FontFamily="Segoe UI" Foreground="{DynamicResource SeleneInkBrush}">
                                            <Run Text="Critics" Foreground="{DynamicResource SeleneInk60Brush}"/><Run Text=" "/><Run Text="{Binding CriticScore, Mode=OneWay}" FontWeight="SemiBold"/>
                                        </TextBlock>
                                    </Border>
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource SeleneScoreBadge}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CommunityScore}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="15" FontFamily="Segoe UI" Foreground="{DynamicResource SeleneInkBrush}">
                                            <Run Text="Players" Foreground="{DynamicResource SeleneInk60Brush}"/><Run Text=" "/><Run Text="{Binding CommunityScore, Mode=OneWay}" FontWeight="SemiBold"/>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>

                                <!-- Play / Install / Resume (Playnite fills it in) and Options -->
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,26,0,0">
                                    <ButtonEx x:Name="PART_ButtonContext" Style="{StaticResource SeleneDetailsButton}"/>
                                    <ButtonEx x:Name="PART_ButtonOptions" Style="{StaticResource SeleneDetailsButton}" Content="{DynamicResource LOCGameOptions}"/>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,28,0,0">
                                    <StackPanel Margin="0,0,28,0">
                                        <TextBlock Text="PLAYTIME" Style="{StaticResource SeleneStatLabel}"/>
                                        <TextBlock Text="{Binding Playtime, Converter={StaticResource PlayTimeToStringConverter}}" Style="{StaticResource SeleneStatValue}"/>
                                    </StackPanel>
                                    <Rectangle Width="1" Fill="{DynamicResource SeleneInk25Brush}" Margin="0,4,28,4"/>
                                    <StackPanel Margin="0,0,28,0">
                                        <TextBlock Text="LAST PLAYED" Style="{StaticResource SeleneStatLabel}"/>
                                        <TextBlock Text="{Binding LastActivity, Converter={StaticResource DateTimeToLastPlayedConverter}}" Style="{StaticResource SeleneStatValue}"/>
                                    </StackPanel>
                                    <!-- released: left out when the game has no date (an empty column under its label) -->
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ReleaseDate}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Rectangle Width="1" Fill="{DynamicResource SeleneInk25Brush}" Margin="0,4,28,4"/>
                                        <StackPanel Margin="0,0,28,0">
                                            <TextBlock Text="RELEASED" Style="{StaticResource SeleneStatLabel}"/>
                                            <TextBlock Text="{Binding ReleaseDate}" Style="{StaticResource SeleneStatValue}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Rectangle Width="1" Fill="{DynamicResource SeleneInk25Brush}" Margin="0,4,28,4"/>
                                    <StackPanel>
                                        <!-- the store's mark and name, as Spotlight shows it (a PC game said "PC (Windows)") -->
                                        <TextBlock Text="PLATFORM" Style="{StaticResource SeleneStatLabel}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <Grid Width="22" Height="22" Margin="0,0,9,0" VerticalAlignment="Center">
                                                <Path Data="{DynamicResource SelenePlatformIcon}" Fill="{DynamicResource SeleneInkBrush}" Stretch="Uniform"/>
                                                <TextBlock Text="{DynamicResource SelenePlatformFallbackGlyph}" FontFamily="{DynamicResource SeleneIconFont}" FontSize="21" Foreground="{DynamicResource SeleneInkBrush}" VerticalAlignment="Center" Visibility="{DynamicResource SelenePlatformFallback}"/>
                                            </Grid>
                                            <TextBlock Text="{DynamicResource SelenePlatformName}" Foreground="{DynamicResource SeleneInkBrush}" FontSize="21" FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- achievements (Playnite Achievements): the count and a thin bar; Y opens the list (Selene Core) -->
                                    <StackPanel x:Name="SeleneAchievementsStat" Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{PluginSettings Plugin=PlayniteAchievements, Path=HasData, FallbackValue=False}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Rectangle Width="1" Fill="{DynamicResource SeleneInk25Brush}" Margin="28,4,28,4"/>
                                        <StackPanel>
                                            <TextBlock Text="ACHIEVEMENTS" Style="{StaticResource SeleneStatLabel}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="&#xEA23;" FontFamily="{DynamicResource SeleneIconFont}" FontSize="21" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource GlyphBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{PluginSettings Plugin=PlayniteAchievements, Path=IsCompleted}" Value="True"><Setter Property="Foreground" Value="#FFE8C46A"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=Unlocked, FallbackValue='-'}" Foreground="{DynamicResource SeleneInkBrush}" FontSize="21" FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Text=" / " Foreground="{DynamicResource SeleneInk60Brush}" FontSize="21" FontFamily="Segoe UI Variable Display, Segoe UI" VerticalAlignment="Center"/>
                                                <TextBlock Text="{PluginSettings Plugin=PlayniteAchievements, Path=Total, FallbackValue='-'}" Foreground="{DynamicResource SeleneInk60Brush}" FontSize="21" FontFamily="Segoe UI Variable Display, Segoe UI" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <ProgressBar Value="{PluginSettings Plugin=PlayniteAchievements, Path=Percent, FallbackValue=0}" Maximum="100" Height="4" Width="150" HorizontalAlignment="Left" Margin="0,6,0,0" Focusable="False">
                                                <ProgressBar.Template>
                                                    <ControlTemplate TargetType="ProgressBar">
                                                        <Grid>
                                                            <Border x:Name="PART_Track" CornerRadius="2" Background="{DynamicResource SeleneInk25Brush}"/>
                                                            <Border x:Name="PART_Indicator" CornerRadius="2" Background="{DynamicResource GlyphBrush}" HorizontalAlignment="Left"/>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </ProgressBar.Template>
                                            </ProgressBar>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <!-- the genres as chips -->
                                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Genres}" Margin="2,22,0,0" IsTabStop="False" Focusable="False">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SeleneChip}">
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontFamily="Segoe UI" Foreground="{DynamicResource SeleneInk90Brush}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- no description in the library (a game added by hand): a quiet line instead of a blank -->
                                <TextBlock DockPanel.Dock="Top" Text="No description for this game yet." Margin="4,20,0,0" FontSize="17" FontFamily="Segoe UI" Foreground="{DynamicResource SeleneInk60Brush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Description}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- the description: the room left above the screenshots (the block ends at a fixed line), five 26 px lines at most,
                                     the last fading out so a long one trails off; the right stick / page keys scroll it -->
                                <Border Margin="2,18,0,0" MaxHeight="130" VerticalAlignment="Top" BorderThickness="0" Padding="0,0,26,0" HorizontalAlignment="Left" MinWidth="700">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="Black" Offset="0"/>
                                            <GradientStop Color="Black" Offset="0.72"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                    <!-- a plain ScrollViewer: Playnite's ScrollViewerEx eases every offset change itself, which fought the right stick's frame-by-frame scroll -->
                                    <ScrollViewer x:Name="PART_ScrollHtmlDescription" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Focusable="False" IsTabStop="False" KeyboardNavigation.DirectionalNavigation="None">
                                        <HtmlTextView x:Name="PART_HtmlDescription" HtmlFontSize="17" Focusable="False" IsTabStop="False"
                                                      HtmlForeground="{DynamicResource SeleneInkColor}" LinkForeground="{DynamicResource GlyphColor}" FocusVisualStyle="{x:Null}"/>
                                    </ScrollViewer>
                                </Border>
                            </DockPanel>

                            <!-- band 1: the game's screenshots -->
                            <StackPanel x:Name="SeleneDetailsBand1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="110,720,0,0">
                                <TextBlock x:Name="SeleneDetailsShotsLabel" Text="Screenshots" Style="{StaticResource SeleneBandLabel}" Visibility="Collapsed"/>
                                <StackPanel x:Name="SeleneDetailsShots" Orientation="Horizontal"/>
                            </StackPanel>

                            <!-- band 2: your captures of it, and your activity with it -->
                            <StackPanel x:Name="SeleneDetailsBand2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="110,950,0,0">
                                <TextBlock Text="Your captures" Style="{StaticResource SeleneBandLabel}"/>
                                <Grid>
                                    <StackPanel x:Name="SeleneDetailsCaptures" Orientation="Horizontal"/>
                                    <TextBlock x:Name="SeleneDetailsCapturesNote" Text="" FontSize="18" FontFamily="Segoe UI" Foreground="{DynamicResource SeleneInk60Brush}" VerticalAlignment="Top" Margin="2,8,0,0" Visibility="Collapsed"/>
                                </Grid>
                            </StackPanel>
                            <Border x:Name="SeleneDetailsBand2b" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,950,110,0" Width="510" Padding="0" BorderThickness="0">
                                <StackPanel>
                                    <TextBlock Text="Your activity" Style="{StaticResource SeleneBandLabel}" Margin="0,0,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                                            <TextBlock Text="PLAY TIME" Style="{StaticResource SeleneStatLabel}"/>
                                            <TextBlock x:Name="SeleneDetailsPlaytime" Style="{StaticResource SeleneStatValue}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                                            <TextBlock Text="LAST PLAYED" Style="{StaticResource SeleneStatLabel}"/>
                                            <TextBlock x:Name="SeleneDetailsLast" Style="{StaticResource SeleneStatValue}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0">
                                            <TextBlock Text="PLAYED THIS WEEK" Style="{StaticResource SeleneStatLabel}"/>
                                            <TextBlock x:Name="SeleneDetailsWeek" Style="{StaticResource SeleneStatValue}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1">
                                            <TextBlock Text="AMONG YOUR MOST PLAYED" Style="{StaticResource SeleneStatLabel}"/>
                                            <TextBlock x:Name="SeleneDetailsRank" Style="{StaticResource SeleneStatValue}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- band 3: more like it, from your own games -->
                            <StackPanel x:Name="SeleneDetailsBand3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="110,1180,0,0">
                                <TextBlock x:Name="SeleneDetailsMoreLabel" Text="More like this" Style="{StaticResource SeleneBandLabel}" Visibility="Collapsed"/>
                                <StackPanel x:Name="SeleneDetailsMore" Orientation="Horizontal"/>
                            </StackPanel>
                        </Grid>
                        </Canvas>
                        </Grid>

                        <!-- the hints along the bottom -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="80,0,0,38">
                            <Grid MinWidth="{DynamicResource SeleneDetailsBadgeWidth}" Height="32">
                                <Ellipse Fill="{DynamicResource SeleneInkBrush}"/>
                                <TextBlock Text="{DynamicResource SelenePromptB}" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{DynamicResource SeleneScrimBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
                            </Grid>
                            <TextBlock Text="Back" Foreground="{DynamicResource SeleneInk90Brush}" FontSize="21" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="10,0,0,2"/>
                            <!-- the right stick scrolls the description from anywhere on the page -->
                            <Grid MinWidth="{DynamicResource SeleneScrollBadgeWidth}" Height="32" Margin="40,0,0,0">
                                <Ellipse Fill="{DynamicResource SeleneInkBrush}"/>
                                <TextBlock Text="{DynamicResource SeleneScrollPrompt}" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{DynamicResource SeleneScrimBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                            </Grid>
                            <TextBlock Text="Scroll" Foreground="{DynamicResource SeleneInk90Brush}" FontSize="21" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="10,0,0,2"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,80,38">
                            <StackPanel x:Name="SeleneAchievementsHint" Orientation="Horizontal" Margin="0,0,40,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=PlayniteAchievements, Path=HasData, FallbackValue=False}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Grid MinWidth="{DynamicResource SeleneDetailsBadgeWidth}" Height="32">
                                    <Ellipse Fill="{DynamicResource SeleneInkBrush}"/>
