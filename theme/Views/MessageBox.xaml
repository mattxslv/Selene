<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Playnite's message boxes (yes / no, an add-on install, errors), in Selene's shape: a glass card with rounded corners,
         the question as a title, the words under it, and pill buttons -->
    <Style x:Key="MessageBoxBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SeleneGlassSolidBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SeleneInk15Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="38,30,38,30" />
        <Setter Property="MinWidth" Value="560" />
        <Setter Property="MaxWidth" Value="900" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="0" BlurRadius="40" Opacity="0.5" Color="Black" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MessageBoxCaptionText" BasedOn="{StaticResource TextBlockBaseStyle}" TargetType="TextBlock" >
        <Setter Property="FontFamily" Value="{DynamicResource FontMain}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SeleneInkBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MessageBoxMessageText" BasedOn="{StaticResource TextBlockBaseStyle}" TargetType="TextBlock" >
        <Setter Property="FontFamily" Value="{DynamicResource FontMain}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="30" />
        <Setter Property="Foreground" Value="{DynamicResource SeleneInk90Brush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- the buttons as pills: glass, the focused one filled with the focus color -->
    <Style x:Key="MessageBoxButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="0,18,12,0" />
        <Setter Property="MinWidth" Value="170" />
        <Setter Property="Height" Value="50" />
        <Setter Property="Padding" Value="30,0" />
        <Setter Property="Foreground" Value="{DynamicResource SeleneInkBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform x:Name="PillScale" ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                        <Border x:Name="Pill" CornerRadius="25" Background="{DynamicResource SeleneInk15Brush}" BorderBrush="{DynamicResource SeleneInk15Brush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,2"
                                              TextElement.Foreground="{DynamicResource SeleneInkBrush}" TextElement.FontSize="20" TextElement.FontFamily="{DynamicResource FontMain}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SeleneFocusBrush}" />
                            <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource SeleneFocusBrush}" />
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource SeleneOnFocusBrush}" />
                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="PillScale" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.15" />
                                <DoubleAnimation Storyboard.TargetName="PillScale" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.15" />
                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="PillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15" />
                                <DoubleAnimation Storyboard.TargetName="PillScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15" />
                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource SeleneFocusBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
